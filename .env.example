# Copy these placeholders into your local environment; never commit real values.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-provider.example/v2/YOUR_API_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_DEDICATED_TEST_WALLET_PRIVATE_KEY

# Deployment scripts require this exact value as an additional human confirmation.
CONFIRM_SEPOLIA_ONLY=I_UNDERSTAND_SEPOLIA_TESTNET_ONLY

# Fill these only after verifying the contracts and their source on Sepolia.
# No official CTF Sepolia address has been verified for this project yet.
SEPOLIA_CTF_ADDRESS=
SEPOLIA_COLLATERAL_ADDRESS=
CONFIRM_CTF_ADDRESS_VERIFIED=I_VERIFIED_THE_OFFICIAL_CTF_SOURCE_AND_SEPOLIA_ADDRESS
